# ─────────────────────────────────────────────────────────────
# 마음명상 환경 변수 예시
# 이 파일을 `.env.local`로 복사한 뒤 값을 채우세요.
# 값이 비어 있으면 앱은 자동으로 "데모 모드"로 실행됩니다.
# ─────────────────────────────────────────────────────────────

# 1) Supabase — 비어 있으면 모든 기록이 이 기기에만 저장됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2) 토스페이먼츠
#    클라이언트 키는 결제창을 여는 데, 시크릿 키는 서버 승인(/api/payments/confirm)에 씁니다.
#    테스트 키: test_ck_..., test_sk_... / 운영 키: live_ck_..., live_sk_...
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 3) 호스트 화면
#    Supabase 모드에서는 users.role = 'host' 로 보호됩니다.
#    아래 값은 Supabase 없이 데모로 호스트 화면을 열 때만 쓰이는 임시 암호입니다.
NEXT_PUBLIC_HOST_PASSCODE=maeum-host

# 4) 배포/문의
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# 5) 1:1 상담 외부 예약 링크
#    비워 두면 앱은 "예약 링크 준비 중" 안내를 띄웁니다.
#    예: NEXT_PUBLIC_COUNSELING_URL=https://cal.com/your-name/1on1
NEXT_PUBLIC_COUNSELING_URL=
